generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CONSULTANT
  OPERATIONS_ANALYST
  MANAGER
}

enum Currency {
  BRL
  USD
  EUR
}

enum OperationStatus {
  PENDING
  UNDER_REVIEW
  COMPLETED
  CANCELED
  PROCESSING
  FAILED
}

enum ProcessingScenario {
  SUCCESS
  FAILURE
}

enum QuoteTimestampKind {
  PROVIDER
  FETCHED_AT
}

enum AuditAction {
  CREATED
  STATUS_CHANGED
}

enum ProposalAuditAction {
  CREATED
  ACCEPTED
  APPROVED
  REJECTED
}

enum RequestStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model User {
  id           String                @id @default(cuid())
  name         String                @db.VarChar(100)
  email        String                @unique @db.VarChar(254)
  passwordHash String                @db.VarChar(255)
  role         Role                  @default(CONSULTANT)
  isActive     Boolean @default(true)
  sessionVersion Int @default(0)
  accessRevision Int @default(0)
  accessChanges EmployeeAccessEvent[] @relation("AccessTarget")
  performedAccessChanges EmployeeAccessEvent[] @relation("AccessActor")
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  operations   ExchangeOperation[]
  simulations  Simulation[]
  auditEvents  OperationAuditEvent[]
  proposals    Proposal[]
  requests     ExchangeRequest[] @relation("RequestAuthor")
  requestDecisions ExchangeRequest[] @relation("RequestReviewer")
  proposalEvents ProposalAuditEvent[]
  processingAttempts OperationProcessingAttempt[]
}

model Customer {
  id           String              @id @default(cuid())
  name         String              @db.VarChar(100)
  fictionalCpf String              @unique @db.VarChar(11)
  email        String              @db.VarChar(254)
  phone        String              @db.VarChar(11)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  operations   ExchangeOperation[]
  proposals    Proposal[]
}

model ExchangeOperation {
  id                 String                @id @default(cuid())
  confirmationKey    String?               @unique @db.VarChar(64)
  customerId         String
  createdById        String
  sourceCurrency     Currency
  targetCurrency     Currency
  sourceAmount       Decimal               @db.Decimal(18, 2)
  targetAmount       Decimal               @db.Decimal(18, 2)
  exchangeRate       Decimal               @db.Decimal(18, 8)
  quoteProvider      String                @db.VarChar(100)
  quoteReferenceDate DateTime?             @db.Date
  quoteTimestamp     DateTime              @db.Timestamptz(3)
  quoteTimestampKind QuoteTimestampKind
  quoteFetchedAt     DateTime              @db.Timestamptz(3)
  status             OperationStatus       @default(PENDING)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)
  customer           Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy          User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  processingAttemptCount Int @default(0)
  processingAttempts OperationProcessingAttempt[]
  request            ExchangeRequest?
  auditEvents        OperationAuditEvent[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([createdById])
}

model OperationAuditEvent {
  id             String            @id @default(cuid())
  operationId    String
  actorId        String
  occurredAt     DateTime          @default(now()) @db.Timestamptz(3)
  action         AuditAction
  previousStatus OperationStatus?
  newStatus      OperationStatus
  operation      ExchangeOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  actor          User              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([operationId, occurredAt, id])
  @@index([actorId])
}

model Simulation {
  id                 String   @id
  confirmationKey    String   @unique @db.VarChar(64)
  createdById        String
  sourceCurrency     Currency
  targetCurrency     Currency
  sourceAmount       Decimal  @db.Decimal(18, 2)
  targetAmount       Decimal  @db.Decimal(18, 2)
  exchangeRate       Decimal  @db.Decimal(18, 8)
  quoteProvider      String   @db.VarChar(100)
  quoteReferenceDate DateTime @db.Date
  quoteFetchedAt     DateTime @db.Timestamptz(3)
  issuedAt           DateTime @db.Timestamptz(3)
  expiresAt          DateTime @db.Timestamptz(3)
  createdBy          User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById, issuedAt])
}

model Proposal {
  id                 String   @id @default(cuid())
  confirmationKey    String   @unique @db.VarChar(64)
  customerId         String
  createdById        String
  sourceCurrency     Currency
  targetCurrency     Currency
  sourceAmount       Decimal  @db.Decimal(18, 2)
  targetAmount       Decimal  @db.Decimal(18, 2)
  exchangeRate       Decimal  @db.Decimal(18, 8)
  quoteProvider      String   @db.VarChar(100)
  quoteReferenceDate DateTime @db.Date
  quoteTimestamp     DateTime @db.Timestamptz(3)
  quoteTimestampKind QuoteTimestampKind
  quoteFetchedAt     DateTime @db.Timestamptz(3)
  issuedAt           DateTime @db.Timestamptz(3)
  expiresAt          DateTime @db.Timestamptz(3)
  acceptedAt         DateTime? @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy          User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  request            ExchangeRequest?
  auditEvents        ProposalAuditEvent[]

  @@index([createdById, createdAt])
  @@index([customerId])
  @@index([createdAt])
}

model ExchangeRequest {
  id          String @id @default(cuid())
  proposalId  String @unique
  createdById String
  status      RequestStatus @default(PENDING_REVIEW)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  operationId String? @unique
  decidedById String?
  decidedAt   DateTime? @db.Timestamptz(3)
  rejectionReason String? @db.VarChar(1000)
  operation ExchangeOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)
  decidedBy User? @relation("RequestReviewer", fields: [decidedById], references: [id], onDelete: Restrict)
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  createdBy   User @relation("RequestAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

model ProposalAuditEvent {
  id         String @id @default(cuid())
  proposalId String
  actorId    String
  action     ProposalAuditAction
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  actor      User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([proposalId, action])
  @@index([proposalId, occurredAt, id])
  @@index([actorId])
}

model OperationProcessingAttempt {
  id String @id @default(cuid())
  operationId String
  number Int
  scenario ProcessingScenario
  startedById String
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  readyAt DateTime @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  failureReason String? @db.VarChar(255)
  operation ExchangeOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  startedBy User @relation(fields: [startedById], references: [id], onDelete: Restrict)

  @@unique([operationId, number])
  @@index([startedById])
}

model EmployeeAccessEvent {
  id String @id @default(cuid())
  employeeId String
  actorId String
  revision Int
  previousRole Role
  newRole Role
  previousIsActive Boolean
  newIsActive Boolean
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  employee User @relation("AccessTarget", fields: [employeeId], references: [id], onDelete: Restrict)
  actor User @relation("AccessActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([employeeId, revision])
  @@index([actorId])
}
