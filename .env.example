# Somente desenvolvimento local. Copie este arquivo para .env.
POSTGRES_USER=exchangedesk
POSTGRES_PASSWORD=exchangedesk_local
POSTGRES_DB=exchangedesk
POSTGRES_PORT=5432
DATABASE_URL="postgresql://exchangedesk:exchangedesk_local@localhost:5432/exchangedesk?schema=public"
# Credenciais de desenvolvimento acima pertencem apenas ao PostgreSQL local.
# Gere um segredo local: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Preencha somente para executar npm run admin:create; remova após criar o administrador.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Banco separado e descartável para os testes de integração (o nome deve terminar em _test).
# TEST_DATABASE_URL="postgresql://exchangedesk:exchangedesk_local@localhost:5432/exchangedesk_stage3_test?schema=public"
# As opções do provedor de cotações serão definidas na etapa 4.
