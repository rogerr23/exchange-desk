# Somente desenvolvimento local. Copie este arquivo para .env.
POSTGRES_USER=exchangedesk
POSTGRES_PASSWORD=exchangedesk_local
POSTGRES_DB=exchangedesk
POSTGRES_PORT=5432
DATABASE_URL="postgresql://exchangedesk:exchangedesk_local@localhost:5432/exchangedesk?schema=public"
# Credenciais de desenvolvimento acima pertencem apenas ao PostgreSQL local.
# Segredo de autenticação e opções de cotações serão definidos nas próximas etapas.
